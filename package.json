{
  "name": "clarify",
  "version": "1.1.0",
  "private": true,
  "main": "electron/dist/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently \"next dev -p 3456\" \"wait-on http://localhost:3456 && electron .\"",
    "build": "next build && tsc -p electron/tsconfig.json",
    "package": "yarn build && electron-builder",
    "release": "yarn build && electron-builder --publish always",
    "lint": "eslint .",
    "start": "electron ."
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@upscalerjs/esrgan-medium": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.8.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.5.0",
    "upscaler": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.7.0",
    "concurrently": "^10.0.7",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "prettier": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.5.7",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "wait-on": "^9.5.1"
  },
  "resolutions": {
    "**/app-builder-lib/minimatch": "^11.0.9",
    "**/@electron/universal/minimatch": "^11.0.9"
  },
  "ct3aMetadata": {
    "initVersion": "7.26.0"
  },
  "packageManager": "yarn@1.22.19"
}
